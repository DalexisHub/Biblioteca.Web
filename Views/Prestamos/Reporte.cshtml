@model IReadOnlyList<PrestamoReporte>
@{ ViewData["Title"] = "Reporte de préstamos"; var consultado = ViewData["Consultado"] is true; }
<div class="section-heading"><div><span class="eyebrow">LAS HISTORIAS EN MOVIMIENTO</span><h1>De mano en mano<span class="coral">.</span></h1><p class="muted">Consulta los préstamos por su fecha de salida, con ambos días incluidos.</p></div><span class="badge yellow">Reporte de préstamos</span></div>
<section class="panel filter-panel"><form method="get" asp-action="Reporte"><div class="date-filters"><div class="field"><label for="desde">Desde</label><input id="desde" name="desde" type="date" value='@ViewData["Desde"]' required /><span>@Html.ValidationMessage("desde")</span></div><div class="field"><label for="hasta">Hasta</label><input id="hasta" name="hasta" type="date" value='@ViewData["Hasta"]' required /><span>@Html.ValidationMessage("hasta")</span></div><button class="button" type="submit">Consultar reporte ↗</button><a class="text-link" asp-action="Reporte">Limpiar</a></div><div asp-validation-summary="All" class="validation" role="alert"></div></form></section>
@if (Model.Count == 0) { <section class="empty"><span class="empty-symbol" aria-hidden="true">▥</span><h2>@(consultado ? "Sin préstamos en estas fechas" : "Cada préstamo tiene una historia")</h2><p>@(consultado ? "Prueba otro intervalo para consultar más movimientos." : "Elige un intervalo de fechas y descubre qué libros han salido a encontrarse con sus lectores.")</p></section> }
else { <div class="section-heading"><h2>Movimientos <span class="count">@Model.Count</span></h2><span class="muted">Una fila por libro prestado</span></div><div class="table-wrap"><table><thead><tr><th scope="col">Socio</th><th scope="col">Libro</th><th scope="col">Fecha de préstamo</th><th scope="col">Fecha límite</th><th scope="col">Estado</th></tr></thead><tbody>@foreach (var fila in Model) { <tr><td><strong>@fila.SocioNombre</strong><small class="author">Préstamo #@fila.PrestamoId</small></td><td>@fila.LibroTitulo</td><td>@fila.FechaPrestamo.ToString("dd/MM/yyyy")</td><td>@fila.FechaLimite.ToString("dd/MM/yyyy")</td><td><span class="badge @(fila.Estado == "Devuelto" ? "mint" : "yellow")">@fila.Estado</span></td></tr> }</tbody></table></div> }
