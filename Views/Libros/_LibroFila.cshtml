@model Libro
<tr><td><div class="book-cell"><div class="book-cover cover-@(Model.LibroId % 4)" aria-hidden="true"><span>BV</span><b>@(string.IsNullOrEmpty(Model.Titulo) ? "L" : Model.Titulo[..1].ToUpper())</b></div><div><a class="book-title" asp-action="Details" asp-route-id="@Model.LibroId">@Model.Titulo</a><span class="author">@Model.AutorNombre</span></div></div></td><td class="isbn">@Model.ISBN</td><td><span class="badge @(Model.Ejemplares > 0 ? "mint" : "yellow")">@Model.Ejemplares @(Model.Ejemplares == 1 ? "ejemplar" : "ejemplares")</span></td><td><div class="row-actions"><a asp-action="Details" asp-route-id="@Model.LibroId" aria-label="Ver @Model.Titulo">Ver</a><a asp-action="Edit" asp-route-id="@Model.LibroId" aria-label="Editar @Model.Titulo">Editar</a><a class="danger-link" asp-action="Delete" asp-route-id="@Model.LibroId" aria-label="Dar de baja @Model.Titulo">Dar de baja</a></div></td></tr>
